# ─── App ──────────────────────────────────────────────
HOST=localhost
BACKEND_PORT=8100
FRONTEND_PORT=5174

# ─── Django ───────────────────────────────────────────
DEBUG=True
DJANGO_SECRET_KEY=unsafe-development-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
JWT_ACCESS_TOKEN_LIFETIME_SECONDS=3600
# Optional: JWT_SECRET_KEY defaults to DJANGO_SECRET_KEY when omitted.

# ─── PostgreSQL ───────────────────────────────────────
POSTGRES_DB=bjeyflow
POSTGRES_USER=bjeyflow
POSTGRES_PASSWORD=bjeyflow-dev-only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# ─── Optional development seed account ─────────────────
SEED_USERNAME=demo
# Leave blank to generate a password on the first seed run.
SEED_PASSWORD=
