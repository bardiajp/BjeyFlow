APP_DOMAIN=bjeyflow.space
APP_URL=https://bjeyflow.space
MAIL_HOST=mail.bjeyflow.space
RELEASE_TAG=production
NGINX_TEMPLATE=http.conf.template
DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-an-independent-long-random-secret
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:postmaster@bjeyflow.space
ALLOWED_HOSTS=bjeyflow.space,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://bjeyflow.space
CORS_ALLOWED_ORIGINS=https://bjeyflow.space
SECURE_SSL_REDIRECT=True
POSTGRES_DB=bjeyflow
POSTGRES_USER=bjeyflow
POSTGRES_PASSWORD=replace-with-a-random-password
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.bjeyflow.space
EMAIL_PORT=465
EMAIL_HOST_USER=noreply@bjeyflow.space
EMAIL_HOST_PASSWORD=replace-with-a-random-mail-password
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL='BjeyFlow <noreply@bjeyflow.space>'
