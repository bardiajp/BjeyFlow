server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${APP_DOMAIN} ${MAIL_HOST};
    server_tokens off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }
    location / {
        default_type text/plain;
        return 503 'BjeyFlow is being prepared. Please check back shortly.';
    }
}
